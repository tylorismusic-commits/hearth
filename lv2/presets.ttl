@prefix lv2:  <http://lv2plug.in/ns/lv2core#> .
@prefix pset: <http://lv2plug.in/ns/ext/presets#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

@prefix hearth: <https://github.com/tylorismusic-commits/hearth> .

hearth:preset_vocal
	a pset:Preset ;
	lv2:appliesTo <https://github.com/tylorismusic-commits/hearth> ;
	rdfs:label "Vocal - Air & Control" ;
	rdfs:comment "Bright, controlled vocal chain with a gentle low cut, wide mid lift and parallel-style compression." ;
			lv2:port [
			lv2:symbol "input_gain" ; pset:value 4
		] ,
		lv2:port [
			lv2:symbol "drive" ; pset:value 2
		] ,
		lv2:port [
			lv2:symbol "character" ; pset:value 30
		] ,
		lv2:port [
			lv2:symbol "hpf" ; pset:value 80
		] ,
		lv2:port [
			lv2:symbol "low_freq" ; pset:value 110
		] ,
		lv2:port [
			lv2:symbol "low_gain" ; pset:value -1
		] ,
		lv2:port [
			lv2:symbol "mid_freq" ; pset:value 3200
		] ,
		lv2:port [
			lv2:symbol "mid_gain" ; pset:value 2
		] ,
		lv2:port [
			lv2:symbol "mid_q" ; pset:value 0.5
		] ,
		lv2:port [
			lv2:symbol "high_freq" ; pset:value 12000
		] ,
		lv2:port [
			lv2:symbol "high_gain" ; pset:value 2
		] ,
		lv2:port [
			lv2:symbol "comp_on" ; pset:value 1
		] ,
		lv2:port [
			lv2:symbol "comp_threshold" ; pset:value -24
		] ,
		lv2:port [
			lv2:symbol "comp_ratio" ; pset:value 3
		] ,
		lv2:port [
			lv2:symbol "comp_attack" ; pset:value 5
		] ,
		lv2:port [
			lv2:symbol "comp_release" ; pset:value 150
		] ,
		lv2:port [
			lv2:symbol "comp_knee" ; pset:value 6
		] ,
		lv2:port [
			lv2:symbol "comp_makeup" ; pset:value 3
		] ,
		lv2:port [
			lv2:symbol "comp_mix" ; pset:value 100
		] ,
		lv2:port [
			lv2:symbol "comp_mode" ; pset:value 0
		] ,
		lv2:port [
			lv2:symbol "output_gain" ; pset:value -2
		] ,
		lv2:port [
			lv2:symbol "enable" ; pset:value 1
		] .

