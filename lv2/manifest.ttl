@prefix lv2:  <http://lv2plug.in/ns/lv2core#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix ui:    <http://lv2plug.in/ns/extensions/ui#> .
@prefix opts:  <http://lv2plug.in/ns/ext/options#> .
@prefix pset:  <http://lv2plug.in/ns/ext/presets#> .

<https://github.com/tylorismusic-commits/hearth>
	a lv2:Plugin ;
	lv2:binary <hearth.so> ;
	rdfs:seeAlso <hearth.ttl> ;
	ui:ui <https://github.com/tylorismusic-commits/hearth#ui> .

<https://github.com/tylorismusic-commits/hearth#ui>
	a ui:X11UI ;
	ui:binary <hearthUI.so> ;
	lv2:requiredFeature ui:idleInterface , ui:parent ;
	lv2:optionalFeature ui:resize , opts:options ;
	lv2:extensionData ui:idleInterface , ui:resize ;
	opts:supportedOption ui:scaleFactor ;
	rdfs:seeAlso <hearth.ttl> .

<https://github.com/tylorismusic-commits/hearth#preset_vocal>
	a pset:Preset ;
	lv2:appliesTo <https://github.com/tylorismusic-commits/hearth> ;
	rdfs:seeAlso <presets.ttl> .

<https://github.com/tylorismusic-commits/hearth#preset_drum_bus>
	a pset:Preset ;
	lv2:appliesTo <https://github.com/tylorismusic-commits/hearth> ;
	rdfs:seeAlso <presets.ttl> .

<https://github.com/tylorismusic-commits/hearth#preset_bass_di>
	a pset:Preset ;
	lv2:appliesTo <https://github.com/tylorismusic-commits/hearth> ;
	rdfs:seeAlso <presets.ttl> .

<https://github.com/tylorismusic-commits/hearth#preset_mix_bus>
	a pset:Preset ;
	lv2:appliesTo <https://github.com/tylorismusic-commits/hearth> ;
	rdfs:seeAlso <presets.ttl> .

<https://github.com/tylorismusic-commits/hearth#preset_acoustic>
	a pset:Preset ;
	lv2:appliesTo <https://github.com/tylorismusic-commits/hearth> ;
	rdfs:seeAlso <presets.ttl> .

<https://github.com/tylorismusic-commits/hearth#preset_broken>
	a pset:Preset ;
	lv2:appliesTo <https://github.com/tylorismusic-commits/hearth> ;
	rdfs:seeAlso <presets.ttl> .

