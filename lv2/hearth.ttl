@prefix lv2:  <http://lv2plug.in/ns/lv2core#> .
@prefix doap:  <http://usefulinc.com/ns/doap#> .
@prefix foaf:  <http://xmlns.com/foaf/0.1/> .
@prefix idpy:  <http://harrisonconsoles.com/lv2/inlinedisplay#> .
@prefix opts: <http://lv2plug.in/ns/ext/options#> .
@prefix pg:   <http://lv2plug.in/ns/ext/port-groups#> .
@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix units: <http://lv2plug.in/ns/extensions/units#> .
@prefix ui:    <http://lv2plug.in/ns/extensions/ui#> .

@prefix hearth: <https://github.com/tylorismusic-commits/hearth> .

<https://github.com/tylorismusic-commits/hearth>
	a lv2:Plugin ,
		lv2:CompressorPlugin ;
	lv2:binary <hearth.so> ;
	lv2:majorVersion 0 ;
	lv2:minorVersion 2 ;
	lv2:microVersion 2 ;
	lv2:project <https://github.com/tylorismusic-commits/hearth> ;
	lv2:optionalFeature lv2:hardRTCapable , idpy:queue_draw , idpy:in_gui ;
	lv2:extensionData idpy:interface ;
	doap:license <https://spdx.org/licenses/GPL-3.0-or-later.html> ;
	doap:name "Hearth Channel" ;
	doap:description "Free and open source channel strip modelled on classic British Class-A consoles." ;
	doap:shortdesc "Neve-inspired channel strip: preamp, EQ, compressor, output fader." ;
	foaf:homepage <https://github.com/tylorismusic-commits/hearth> ;
	ui:ui <https://github.com/tylorismusic-commits/hearth#ui> ;
	lv2:port
		[
			a lv2:AudioPort ,
			lv2:InputPort ;
			lv2:index 0 ;
			lv2:symbol "in_l" ;
			lv2:name "Input Left" ;
			pg:group <hearth#input> ;
			lv2:designation pg:left ;
			lv2:documentation "Left input of the channel strip." ;
			] ,
		[
			a lv2:AudioPort ,
			lv2:InputPort ;
			lv2:index 1 ;
			lv2:symbol "in_r" ;
			lv2:name "Input Right" ;
			pg:group <hearth#input> ;
			lv2:designation pg:right ;
			lv2:documentation "Right input of the channel strip." ;
			] ,
		[
			a lv2:AudioPort ,
			lv2:OutputPort ;
			lv2:index 2 ;
			lv2:symbol "out_l" ;
			lv2:name "Output Left" ;
			pg:group <hearth#output> ;
			lv2:designation pg:left ;
			lv2:documentation "Left output of the channel strip." ;
			] ,
		[
			a lv2:AudioPort ,
			lv2:OutputPort ;
			lv2:index 3 ;
			lv2:symbol "out_r" ;
			lv2:name "Output Right" ;
			pg:group <hearth#output> ;
			lv2:designation pg:right ;
			lv2:documentation "Right output of the channel strip." ;
			] ,
		[
			a lv2:ControlPort ,
			lv2:InputPort ;
			lv2:index 4 ;
			lv2:symbol "input_gain" ;
			lv2:name "Input Gain" ;
			lv2:group <hearth#preamp> ;
			lv2:default 0 ;
			lv2:minimum -20 ;
			lv2:maximum 30 ;
			units:unit units:db ;
			lv2:documentation "Trim before the input stage." ;
			] ,
		[
			a lv2:ControlPort ,
			lv2:InputPort ;
			lv2:index 5 ;
			lv2:symbol "drive" ;
			lv2:name "Drive" ;
			lv2:group <hearth#preamp> ;
			lv2:default 0 ;
			lv2:minimum 0 ;
			lv2:maximum 12 ;
			units:unit units:db ;
			lv2:documentation "Input stage drive producing asymmetric soft saturation." ;
			] ,
		[
			a lv2:ControlPort ,
			lv2:InputPort ;
			lv2:index 6 ;
			lv2:symbol "character" ;
			lv2:name "Character" ;
			lv2:group <hearth#preamp> ;
			lv2:default 25 ;
			lv2:minimum 0 ;
			lv2:maximum 100 ;
			units:unit units:pc ;
			lv2:documentation "Saturation character, 0 is clean, 100 is fully coloured." ;
			] ,
		[
			a lv2:ControlPort ,
			lv2:InputPort ;
			lv2:index 7 ;
			lv2:symbol "hpf" ;
			lv2:name "High-Pass" ;
			lv2:group <hearth#eq> ;
			lv2:default 0 ;
			lv2:minimum 0 ;
			lv2:maximum 300 ;
			units:unit units:hz ;
			lv2:scalePoint [ rdfs:label "Off" ; rdf:value 0 ] ;
			lv2:scalePoint [ rdfs:label "50" ; rdf:value 50 ] ;
			lv2:scalePoint [ rdfs:label "80" ; rdf:value 80 ] ;
			lv2:scalePoint [ rdfs:label "160" ; rdf:value 160 ] ;
			lv2:scalePoint [ rdfs:label "300" ; rdf:value 300 ] ;
			lv2:documentation "High-pass, 18 dB/oct, 0 disables." ;
			] ,
		[
			a lv2:ControlPort ,
			lv2:InputPort ;
			lv2:index 8 ;
			lv2:symbol "low_freq" ;
			lv2:name "Low Freq" ;
			lv2:group <hearth#eq> ;
			lv2:default 110 ;
			lv2:minimum 30 ;
			lv2:maximum 250 ;
			units:unit units:hz ;
			lv2:portProperty lv2:logarithmic ;
			lv2:scalePoint [ rdfs:label "35" ; rdf:value 35 ] ;
			lv2:scalePoint [ rdfs:label "60" ; rdf:value 60 ] ;
			lv2:scalePoint [ rdfs:label "110" ; rdf:value 110 ] ;
			lv2:scalePoint [ rdfs:label "220" ; rdf:value 220 ] ;
			] ,
		[
			a lv2:ControlPort ,
			lv2:InputPort ;
			lv2:index 9 ;
			lv2:symbol "low_gain" ;
			lv2:name "Low Gain" ;
			lv2:group <hearth#eq> ;
			lv2:default 0 ;
			lv2:minimum -8 ;
			lv2:maximum 8 ;
			units:unit units:db ;
			] ,
		[
			a lv2:ControlPort ,
			lv2:InputPort ;
			lv2:index 10 ;
			lv2:symbol "mid_freq" ;
			lv2:name "Mid Freq" ;
			lv2:group <hearth#eq> ;
			lv2:default 1600 ;
			lv2:minimum 200 ;
			lv2:maximum 8000 ;
			units:unit units:hz ;
			lv2:portProperty lv2:logarithmic ;
			lv2:scalePoint [ rdfs:label "360" ; rdf:value 360 ] ;
			lv2:scalePoint [ rdfs:label "700" ; rdf:value 700 ] ;
			lv2:scalePoint [ rdfs:label "1600" ; rdf:value 1600 ] ;
			lv2:scalePoint [ rdfs:label "3200" ; rdf:value 3200 ] ;
			lv2:scalePoint [ rdfs:label "4800" ; rdf:value 4800 ] ;
			lv2:scalePoint [ rdfs:label "7200" ; rdf:value 7200 ] ;
			] ,
		[
			a lv2:ControlPort ,
			lv2:InputPort ;
			lv2:index 11 ;
			lv2:symbol "mid_gain" ;
			lv2:name "Mid Gain" ;
			lv2:group <hearth#eq> ;
			lv2:default 0 ;
			lv2:minimum -9 ;
			lv2:maximum 9 ;
			units:unit units:db ;
			] ,
		[
			a lv2:ControlPort ,
			lv2:InputPort ;
			lv2:index 12 ;
			lv2:symbol "mid_q" ;
			lv2:name "Mid Q" ;
			lv2:group <hearth#eq> ;
			lv2:default 0.4 ;
			lv2:minimum 0.2 ;
			lv2:maximum 2 ;
			lv2:portProperty lv2:logarithmic ;
			] ,
		[
			a lv2:ControlPort ,
			lv2:InputPort ;
			lv2:index 13 ;
			lv2:symbol "high_freq" ;
			lv2:name "High Freq" ;
			lv2:group <hearth#eq> ;
			lv2:default 12000 ;
			lv2:minimum 6000 ;
			lv2:maximum 16000 ;
			units:unit units:hz ;
			lv2:portProperty lv2:logarithmic ;
			lv2:scalePoint [ rdfs:label "10k" ; rdf:value 10000 ] ;
			lv2:scalePoint [ rdfs:label "12k" ; rdf:value 12000 ] ;
			lv2:scalePoint [ rdfs:label "16k" ; rdf:value 16000 ] ;
			] ,
		[
			a lv2:ControlPort ,
			lv2:InputPort ;
			lv2:index 14 ;
			lv2:symbol "high_gain" ;
			lv2:name "High Gain" ;
			lv2:group <hearth#eq> ;
			lv2:default 0 ;
			lv2:minimum -8 ;
			lv2:maximum 8 ;
			units:unit units:db ;
			] ,
		[
			a lv2:ControlPort ,
			lv2:InputPort ;
			lv2:index 15 ;
			lv2:symbol "comp_on" ;
			lv2:name "Compressor" ;
			lv2:group <hearth#comp> ;
			lv2:default 1 ;
			lv2:minimum 0 ;
			lv2:maximum 1 ;
			lv2:portProperty lv2:integer ,
			lv2:toggled ;
			lv2:documentation "Master compressor bypass." ;
			] ,
		[
			a lv2:ControlPort ,
			lv2:InputPort ;
			lv2:index 16 ;
			lv2:symbol "comp_threshold" ;
			lv2:name "Threshold" ;
			lv2:group <hearth#comp> ;
			lv2:default -18 ;
			lv2:minimum -60 ;
			lv2:maximum 0 ;
			units:unit units:db ;
			] ,
		[
			a lv2:ControlPort ,
			lv2:InputPort ;
			lv2:index 17 ;
			lv2:symbol "comp_ratio" ;
			lv2:name "Ratio" ;
			lv2:group <hearth#comp> ;
			lv2:default 4 ;
			lv2:minimum 1 ;
			lv2:maximum 20 ;
			lv2:portProperty lv2:logarithmic ;
			] ,
		[
			a lv2:ControlPort ,
			lv2:InputPort ;
			lv2:index 18 ;
			lv2:symbol "comp_attack" ;
			lv2:name "Attack" ;
			lv2:group <hearth#comp> ;
			lv2:default 10 ;
			lv2:minimum 0.1 ;
			lv2:maximum 100 ;
			units:unit units:ms ;
			lv2:portProperty lv2:logarithmic ;
			] ,
		[
			a lv2:ControlPort ,
			lv2:InputPort ;
			lv2:index 19 ;
			lv2:symbol "comp_release" ;
			lv2:name "Release" ;
			lv2:group <hearth#comp> ;
			lv2:default 250 ;
			lv2:minimum 20 ;
			lv2:maximum 2000 ;
			units:unit units:ms ;
			lv2:portProperty lv2:logarithmic ;
			] ,
		[
			a lv2:ControlPort ,
			lv2:InputPort ;
			lv2:index 20 ;
			lv2:symbol "comp_knee" ;
			lv2:name "Knee" ;
			lv2:group <hearth#comp> ;
			lv2:default 6 ;
			lv2:minimum 0 ;
			lv2:maximum 24 ;
			units:unit units:db ;
			] ,
		[
			a lv2:ControlPort ,
			lv2:InputPort ;
			lv2:index 21 ;
			lv2:symbol "comp_makeup" ;
			lv2:name "Makeup" ;
			lv2:group <hearth#comp> ;
			lv2:default 0 ;
			lv2:minimum 0 ;
			lv2:maximum 30 ;
			units:unit units:db ;
			] ,
		[
			a lv2:ControlPort ,
			lv2:InputPort ;
			lv2:index 22 ;
			lv2:symbol "comp_mix" ;
			lv2:name "Mix" ;
			lv2:group <hearth#comp> ;
			lv2:default 100 ;
			lv2:minimum 0 ;
			lv2:maximum 100 ;
			units:unit units:pc ;
			] ,
		[
			a lv2:ControlPort ,
			lv2:InputPort ;
			lv2:index 23 ;
			lv2:symbol "comp_mode" ;
			lv2:name "Topology" ;
			lv2:group <hearth#comp> ;
			lv2:default 0 ;
			lv2:minimum 0 ;
			lv2:maximum 1 ;
			lv2:portProperty lv2:integer ,
			lv2:enumeration ;
			lv2:scalePoint [ rdfs:label "Feed-forward" ; rdf:value 0 ] ;
			lv2:scalePoint [ rdfs:label "Feedback" ; rdf:value 1 ] ;
			] ,
		[
			a lv2:ControlPort ,
			lv2:InputPort ;
			lv2:index 24 ;
			lv2:symbol "output_gain" ;
			lv2:name "Output" ;
			lv2:group <hearth#output_section> ;
			lv2:default 0 ;
			lv2:minimum -60 ;
			lv2:maximum 12 ;
			units:unit units:db ;
			] ,
		[
			a lv2:ControlPort ,
			lv2:InputPort ;
			lv2:index 25 ;
			lv2:symbol "enable" ;
			lv2:name "Enabled" ;
			lv2:group <hearth#global> ;
			lv2:default 1 ;
			lv2:minimum 0 ;
			lv2:maximum 1 ;
			lv2:portProperty lv2:integer ,
			lv2:toggled ;
			] ,
		[
			a lv2:ControlPort ,
			lv2:OutputPort ;
			lv2:index 26 ;
			lv2:symbol "gr_meter" ;
			lv2:name "Gain Reduction" ;
			lv2:group <hearth#global> ;
			lv2:default 0 ;
			lv2:minimum -60 ;
			lv2:maximum 0 ;
			units:unit units:db ;
			lv2:documentation "Gain reduction applied by the compressor, in dB (negative)." ;
			] ,
		[
			a lv2:ControlPort ,
			lv2:OutputPort ;
			lv2:index 27 ;
			lv2:symbol "out_meter" ;
			lv2:name "Output Level" ;
			lv2:group <hearth#global> ;
			lv2:default -60 ;
			lv2:minimum -60 ;
			lv2:maximum 6 ;
			units:unit units:db ;
			lv2:documentation "Peak output level in dBFS of the last block." ;
			] .

# Audio input / output groups
<hearth#input>
	a pg:Group ;
	lv2:name "Input" ;
	lv2:symbol "input" ;
	.

<hearth#output>
	a pg:Group ;
	lv2:name "Output" ;
	lv2:symbol "output" ;
	.

<hearth#preamp>
	a pg:Group ;
	lv2:name "Preamp" ;
	lv2:symbol "preamp" ;
	.

<hearth#eq>
	a pg:Group ;
	lv2:name "EQ" ;
	lv2:symbol "eq" ;
	.

<hearth#comp>
	a pg:Group ;
	lv2:name "Compressor" ;
	lv2:symbol "comp" ;
	.

<hearth#output_section>
	a pg:Group ;
	lv2:name "Output Fader" ;
	lv2:symbol "output" ;
	.

<hearth#global>
	a pg:Group ;
	lv2:name "Global" ;
	lv2:symbol "global" ;
	.

<hearth#ui>
	a ui:X11UI ;
	ui:binary <hearthUI.so> ;
	lv2:requiredFeature ui:idleInterface , ui:parent ;
	lv2:optionalFeature ui:resize , opts:options ;
	lv2:extensionData ui:idleInterface , ui:resize ;
	opts:supportedOption ui:scaleFactor ;
	ui:portNotification [
			ui:plugin <https://github.com/tylorismusic-commits/hearth> ;
			ui:portIndex 26 ;
	] , [
			ui:plugin <https://github.com/tylorismusic-commits/hearth> ;
			ui:portIndex 27 ;
	] ;
	.
